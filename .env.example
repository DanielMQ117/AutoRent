# ============================================================================
# CONFIGURACION DE ENTORNO (EJEMPLO)
# Copia este archivo como .env y ajusta los valores para tu entorno local
# ============================================================================

# Informacion General de la Aplicacion
APP_NAME="AutoRent Pro - Sistema de Alquiler de Automóviles"
APP_ENV=development
APP_DEBUG=true

# Configuracion de Conexion a Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agencia_autos_db
DB_USER=postgres
DB_PASSWORD=postgres

# Configuracion del Pool de Conexiones
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=30

# Sistema de Logging
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_FILE=app.log
