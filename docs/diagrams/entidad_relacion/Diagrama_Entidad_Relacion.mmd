    CATEGORIA_VEHICULO ||--o{ VEHICULO : "clasifica"
    VEHICULO ||--o{ MANTENIMIENTO : "recibe"
    USUARIO ||--o{ MANTENIMIENTO : "supervisa"

    %% Clientes y Documentación
